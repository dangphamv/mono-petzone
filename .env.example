# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=http://127.0.0.1:54321

# NestJS API
API_PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Payment Gateways v1
# URLs used to build redirect/IPN callbacks. RETURN_URL is what the gateway
# hands back to the mobile app/browser (should be a Universal Link / App Link).
# IPN_BASE_URL is our own public HTTPS host — gateways POST IPN to
# `${IPN_BASE_URL}/api/payments/callback/<gateway>`.
PAYMENTS_V1_RETURN_URL=https://app.petzone.vn/payment/return
PAYMENTS_V1_IPN_BASE_URL=https://api.petzone.vn

# VietQR direct-to-provider (SePay webhook)
# - SEPAY_API_KEY: secret string SePay gửi qua "Authorization: Apikey <key>"
#   Lấy tại sepay.vn dashboard → Cài đặt → Tích hợp Webhook
# - VIETQR_TEMPLATE: layout QR từ img.vietqr.io (compact | compact2 | qr_only | print)
# - DEV_SIMULATE_ENABLED: bật endpoint POST /payments/:id/dev-simulate-paid
#   cho team app test full E2E mà KHÔNG cần chuyển tiền thật.
#   TUYỆT ĐỐI để 'false' trên production.
SEPAY_API_KEY=
VIETQR_TEMPLATE=compact2
DEV_SIMULATE_ENABLED=false

# MoMo AIO v2 (captureWallet)
# Sandbox public test creds (good to start dev before signing with MoMo):
#   MOMO_PARTNER_CODE=MOMO
#   MOMO_ACCESS_KEY=F8BBA842ECF85
#   MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=PetZone
MOMO_STORE_ID=PetZone

# VNPay (chưa tích hợp — placeholder cho phase 2)
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret

# ZaloPay (chưa tích hợp — placeholder cho phase 3)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# Payments v2 (PSP: 9Pay)
PAYMENTS_V2_ENABLED=false
NINEPAY_ENABLED=false
NINEPAY_BASE_URL=https://sand-payment.9pay.vn
NINEPAY_MERCHANT_KEY=your-9pay-merchant-key
NINEPAY_SECRET=your-9pay-secret
NINEPAY_WEBHOOK_SECRET=your-9pay-webhook-secret
NINEPAY_PETZONE_BANK_NAME=Vietcombank
NINEPAY_PETZONE_ACCOUNT_NUMBER=0123456789
NINEPAY_PETZONE_ACCOUNT_HOLDER=PetZone JSC

# Firebase Cloud Messaging (push notifications)
# Lấy từ Firebase Console → Project Settings → Service accounts → Generate new private key
# PRIVATE_KEY là chuỗi PEM nhiều dòng — Railway nhận literal \n, code tự unescape
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email — SendGrid (password reset). Leave SENDGRID_API_KEY empty in dev → emails are logged, not sent.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@petzone.com
SENDGRID_FROM_NAME=PetZone
PASSWORD_RESET_REDIRECT_URL=https://petzone-admin.vercel.app/reset-password

# Masked Calls
STRINGEE_API_KEY=your-stringee-key
STRINGEE_SECRET=your-stringee-secret
